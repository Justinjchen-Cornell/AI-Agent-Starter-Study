# ===========================================
# AI-Agent-Starter-Study - 环境变量模板
# 用法：复制本文件为 .env，填入你自己的密钥
# 注意：.env 已被 .gitignore 排除，永远不会上传到 Git
# ===========================================

# ---------- LLM 大模型配置（示例：DeepSeek）----------
# 任何 OpenAI 兼容服务均可：DeepSeek / 通义千问 / OpenAI ...
# DeepSeek 开放平台：https://platform.deepseek.com
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-deepseek-key

# 模型名称（代码只读取这一个变量，见 agent/llm.py）
LLM_QWEN_MAX=deepseek-chat

# ---------- Tavily 网络搜索 ----------
# 注册地址（有免费额度）: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key

# ---------- RAGFlow 知识库服务（可选，不配也能跑）----------
RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key

# ---------- MySQL 数据库（可选，不配也能跑）----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306
